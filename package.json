{
  "name": "@chaeco/sqlo",
  "version": "0.3.2",
  "description": "Lightweight, SQLite-only ORM built on Node.js built-in node:sqlite. Zero native dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.mjs && rm -rf dist/.cache && tsc -p tsconfig.test.json && rm -rf dist/src && node scripts/rewrite-tests.mjs",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.2.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "sqlite",
    "orm",
    "node:sqlite",
    "sql",
    "database",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaeco/sqlo.git"
  },
  "bugs": {
    "url": "https://github.com/chaeco/sqlo/issues"
  },
  "homepage": "https://github.com/chaeco/sqlo#readme"
}
